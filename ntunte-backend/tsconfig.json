{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
//    "moduleResolution": "node",
    "moduleResolution\": \"bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}